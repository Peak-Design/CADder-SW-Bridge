bin/
obj/
dist/
*.user
*.suo
.vs/
__pycache__/
*.pyc
*.blend1
~$*

# Internal notes: plans, the work list, the full change log, the release
# steps and the tool notes. They stay on this machine. The root names are
# listed as well, so a note written in the old place is not committed.
.claude/
/PLAN.md
/TODO.md
/CHANGELOG.md
/RELEASING.md

# The test corpus: the models, their build recipes and the manifests
# exported from them. None of it is published. The tests replay recorded
# fixtures under sw-addin/tests, which come from test models only.
/test-assemblies/

# CAD data and everything an export produces from it.
*.SLDASM
*.SLDPRT
*.step
*.swmesh

# Generated by the C# test suite for the cross-language .swmesh test.
golden/

# Heavy working files: renders, recordings, large exports.
/assets/
