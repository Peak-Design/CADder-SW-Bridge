<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CorpusExport</AssemblyName>
    <RootNamespace>Peak.Cadder.Tools</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The add-in project is a WinForms library; the harness inherits the
         reference and needs the same switch to compile against it. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Peak.Cadder\Peak.Cadder.csproj" />
  </ItemGroup>

  <Import Project="..\..\SolidWorksApi.props" />

</Project>
