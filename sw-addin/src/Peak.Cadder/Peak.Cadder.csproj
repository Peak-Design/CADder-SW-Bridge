<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>Peak.Cadder</AssemblyName>
    <RootNamespace>Peak.Cadder</RootNamespace>
    <!--
      Single source of the version. AddIn.AddInVersion reads it back off the
      assembly, the installer reads it off the built DLL, and the release
      script tags from it, so there is exactly one number to bump.
    -->
    <Version>1.1.1</Version>
    <Authors>Peak Design</Authors>
    <Product>CADder Bridge for SolidWorks</Product>
    <Description>Exports the assembly's kinematics as a rig manifest next to a STEP file, for the CADder Blender add-on.</Description>
    <Copyright>Copyright (c) 2026 Peak Design</Copyright>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded interop types make every COM member that returns object a
         late-bound call, and the binder for those lives here. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core's mate predicates are internal on purpose: they are this
         add-in's reading of the mate table, not an API. The tests pin them
         directly because that reading is the thing most worth pinning. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Peak.Cadder.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      SolidWorks reads these files by absolute path while it runs. They must
      therefore sit next to the DLL. They cannot be embedded resources.
    -->
    <Content Include="icons\*.png" Link="icons\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Import Project="..\..\SolidWorksApi.props" />

</Project>
